# 抖图 AI · 环境变量模板
#
# 使用方式：复制为 .env.local 后按需填写（.env.local 已被 .gitignore 忽略，不会提交）。
#
# 安全约束（规格书 §24，硬性要求）：
#   1. 模型密钥只允许存在于服务端环境变量中，禁止使用 NEXT_PUBLIC_ 前缀。
#   2. 日志、API 响应、错误信息中都不得输出密钥原文或完整图片 base64。
#   3. P0/P1 阶段尚未接入真实 AI，因此 AI_API_KEY 留空即可正常启动与验收。

# 供应商标识，仅用于 /api/health 展示与服务端日志
AI_PROVIDER=dashscope

# OpenAI 兼容协议的 base URL（默认：阿里云百炼兼容模式）
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型 API Key —— P2 接入视觉分析前保持为空
AI_API_KEY=

# 视觉模型：只用于图片分析（规格书 §5 Step 2）
AI_VISION_MODEL=

# 文本模型：用于选题 / 标题 / 正文 / 标签（规格书 §18）
AI_TEXT_MODEL=
